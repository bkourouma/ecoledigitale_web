# =========================================================
# Site marketing EcoleDigitale — variables d'environnement
# Copier ce fichier vers .env.local et renseigner les valeurs
# =========================================================

# --- Envoi formulaire demo (Google Apps Script) ---
# URL /exec du Web App Google Apps Script deploye.
# Tant que cette valeur est vide, le dev local utilise /api/leads comme fallback.
NEXT_PUBLIC_GOOGLE_APPS_SCRIPT_URL=

# --- Email transactionnel (Resend, fallback historique /api/leads) ---
# Obtenez une clé sur https://resend.com (free tier 3000 emails/mois)
# En dev sans clé : ResendLeadSink log un warning, le formulaire renvoie quand même 200 OK
RESEND_API_KEY=

# Destinataire interne (équipe commerciale)
LEADS_TO_EMAIL=commercial@ecoledigitale.com

# Expéditeur (doit être un domaine vérifié dans Resend)
LEADS_FROM_EMAIL=noreply@ecoledigitale.com

# --- Analytics (Umami) ---
# Aucune variable : le script (components/analytics/UmamiScript.tsx) compte le domaine de NEXT_PUBLIC_SITE_URL,
# uniquement en production. L'identifiant du site Umami est public et vit dans ce composant.

# --- Coordonnées de contact publiques ---
# Elles ne sont plus lues dans l'environnement : téléphone, WhatsApp (+225 01 01 51 01 36) et e-mail
# public vivent dans lib/site/contact.ts, pour qu'un secret mal renseigné ne les fasse plus diverger.
# NEXT_PUBLIC_CONTACT_EMAIL, NEXT_PUBLIC_CONTACT_PHONE et NEXT_PUBLIC_WHATSAPP_NUMBER sont sans effet.

# --- Sécurité / anti-abus ---
# Activer le rate limiting sur /api/leads (5 req/IP/h). false en dev local.
RATE_LIMIT_ENABLED=false

# --- Métadonnées site ---
# URL canonique de la production (utilisé pour les balises canonical/og:url et sitemap)
NEXT_PUBLIC_SITE_URL=https://ecoledigitale.allianceconsultants.net
